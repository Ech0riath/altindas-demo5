Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Gizli dosya ve klasörler (.git vb.) dışarıya kapalı.
  RewriteRule (^|/)\. - [F]
  # Panel her zaman uygulamadan sunulur; klasörde eski dosya kalsa bile.
  RewriteRule ^admin(/|$) index.php [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "\.(json|md|sql|log|lock|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
